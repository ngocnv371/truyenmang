{
  "kind": "collectionType",
  "collectionName": "chapters",
  "info": {
    "singularName": "chapter",
    "pluralName": "chapters",
    "displayName": "Chapters"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "order": {
      "type": "integer",
      "required": true
    },
    "content": {
      "type": "text",
      "required": true
    },
    "book": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::book.book",
      "inversedBy": "chapters"
    },
    "comments": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::chapter-comment.chapter-comment",
      "mappedBy": "chapter"
    }
  }
}
